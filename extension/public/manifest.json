{
  "manifest_version": 3,
  "name": "Lattice for ChatGPT",
  "version": "0.2.0",
  "description": "主线不断、支线就地追问：可收起并保存上下文的树形 ChatGPT 对话。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "css": ["native.css"],
    "run_at": "document_idle",
    "world": "ISOLATED"
  }]
}
