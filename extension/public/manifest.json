{
  "manifest_version": 3,
  "name": "Lattice for ChatGPT",
  "version": "0.3.2",
  "description": "点击原文下划线展开悬浮支线，回到主线自动收起，并保留树形对话与原生上下文。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "css": ["native.css"],
    "run_at": "document_idle",
    "world": "ISOLATED"
  }]
}
